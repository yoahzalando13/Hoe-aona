# Copiez ce fichier en .env puis renseignez les clés gratuites dont vous disposez.
# L'application fonctionne sans clé, en mode dégradé (Wikipedia, GDELT, Banque mondiale restent actifs).

# LLM compatibles OpenAI (au moins un recommandé)
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=              # https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
LLM_PRIORITY=gemini,groq

# Sources de preuves
TAVILY_API_KEY=            # https://app.tavily.com (recherche web, sites officiels et presse malgaches)
NEWSDATA_API_KEY=          # https://newsdata.io/register (presse malgache récente, country=mg)
# Détection IA image et OCR de secours
SIGHTENGINE_API_USER=      # https://sightengine.com
SIGHTENGINE_API_SECRET=
OCR_SPACE_API_KEY=         # https://ocr.space/ocrapi

# Comptes : le premier inscrit devient administrateur
ALLOW_REGISTRATION=true
SESSION_DAYS=30
COOKIE_SECURE=false        # true derrière HTTPS

# Vérification physique (application mobile uniquement) : PostgreSQL avec l'extension PostGIS.
# Sans cette URL, la fonction est désactivée. Les positions des comptes ne sont jamais renvoyées par l'API.
POSTGIS_URL=               # ex. postgresql://hoe:hoe@localhost:5432/hoe_aona
VERIFICATION_RADIUS_M=2000
VERIFICATION_HOURS=24
LOCATION_MAX_AGE_MINUTES=120
VERIFICATION_ON_SITE_M=300
VERIFICATION_MAX_ACCURACY_M=150
CAPTURE_TOKEN_MINUTES=20

# MCP : "mcp" (outils appelés via le serveur MCP) ou "direct"
MCP_MODE=mcp
CORS_ORIGINS=["http://localhost:4200"]
