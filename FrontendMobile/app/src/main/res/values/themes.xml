<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HoeAona" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/primary_light</item>
        <item name="colorSecondaryContainer">@color/primary_container</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/line_strong</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/ink2</item>
        <item name="shapeAppearanceSmallComponent">@style/Hoe.Shape.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Hoe.Shape.Small</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Hoe.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="android:background">@color/paper</item>
        <item name="navigationIcon">@drawable/ic_back</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.Hoe.ToolbarTitle</item>
    </style>

    <!-- Coins discrets plutôt que pilules -->
    <style name="Hoe.Shape.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>

    <!-- Cartes filetées, sans ombre : le papier fait le contraste. -->
    <style name="Hoe.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/gray_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="Hoe.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Hoe.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Hoe.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- Titres en serif, couleur d'encre : la marque reste un accent. -->
    <style name="TextAppearance.Hoe.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Hoe.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Intertitre de rubrique : petites capitales espacées. -->
    <style name="TextAppearance.Hoe.SectionLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/ink2</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Chiffres de presse : serif, chiffres alignés. -->
    <style name="TextAppearance.Hoe.Figure" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFeatureSettings">lnum, tnum</item>
    </style>

    <style name="TextAppearance.Hoe.Figure.Small">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.Hoe.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Hoe.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/gray_text</item>
    </style>

    <style name="Hoe.MenuItem" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/menu_item_bg</item>
        <item name="android:drawablePadding">20dp</item>
        <item name="android:drawableTint">@color/primary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Hoe.Body</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Hoe.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
