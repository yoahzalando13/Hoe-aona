<?xml version="1.0" encoding="utf-8"?>
<!-- Constat certifié : verdict, contrôles (capture, présence, signature), empreinte, photo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical">
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/text_primary"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp">
        <TextView
            android:id="@+id/tvWho"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Hoe.SectionLabel"/>
        <TextView
            android:id="@+id/tvOutcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tvChecks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:textAppearance="@style/TextAppearance.Hoe.Body"
        android:textSize="13sp"/>
    <TextView
        android:id="@+id/tvText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.Hoe.Body"
        android:textIsSelectable="true"/>
    <ImageView
        android:id="@+id/ivPhoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/verif_photo"
        android:visibility="gone"/>
    <TextView
        android:id="@+id/tvHash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textAppearance="@style/TextAppearance.Hoe.Meta"
        android:textIsSelectable="true"
        android:textSize="11sp"/>
</LinearLayout>
