<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gray_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Hoe.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/verif_detail_title"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvClaim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.Hoe.Subtitle"
                android:textIsSelectable="true"/>
            <TextView
                android:id="@+id/tvDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.Hoe.Body"/>
            <TextView
                android:id="@+id/tvPlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/ic_place"
                android:drawablePadding="4dp"
                android:drawableTint="@color/primary"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Hoe.Body"/>
            <TextView
                android:id="@+id/tvPeople"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.Hoe.Meta"/>

            <org.osmdroid.views.MapView
                android:id="@+id/map"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp"/>

            <!-- Résultat du constat -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutResult"
                style="@style/Hoe.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/verif_result"
                        android:textAppearance="@style/TextAppearance.Hoe.SectionLabel"/>
                    <TextView
                        android:id="@+id/tvOutcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvReport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.Hoe.Body"
                        android:textIsSelectable="true"/>
                    <ImageView
                        android:id="@+id/ivPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/verif_photo"
                        android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Destinataire : accepter ou refuser -->
            <TextView
                android:id="@+id/tvPrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/verif_recipient_privacy"
                android:textAppearance="@style/TextAppearance.Hoe.Meta"
                android:textStyle="italic"
                android:visibility="gone"/>
            <LinearLayout
                android:id="@+id/layoutRecipientActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDecline"
                    style="@style/Hoe.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/verif_decline"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAccept"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="@string/verif_accept"/>
            </LinearLayout>

            <!-- Vérificateur : se rendre sur place, puis rendre le constat -->
            <LinearLayout
                android:id="@+id/layoutVerifierActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNavigate"
                    style="@style/Hoe.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/verif_navigate"
                    app:icon="@drawable/ic_directions"
                    app:iconTint="@color/primary"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRelease"
                    style="@style/Hoe.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/verif_release"/>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutReportForm"
                style="@style/Hoe.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/verif_report_title"
                        android:textAppearance="@style/TextAppearance.Hoe.Subtitle"/>
                    <RadioGroup
                        android:id="@+id/rgOutcome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbCorrect"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/verif_outcome_correct_long"/>
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbIncorrect"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/verif_outcome_incorrect_long"/>
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbUndetermined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/verif_outcome_indetermine_long"/>
                    </RadioGroup>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Hoe.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/verif_report_hint">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etReport"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="4000"
                            android:minLines="3"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <ImageView
                        android:id="@+id/ivReportPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:contentDescription="@string/verif_photo"
                        android:scaleType="centerCrop"
                        android:visibility="gone"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTakePhoto"
                            style="@style/Hoe.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/verif_take_photo"
                            app:icon="@drawable/ic_camera"
                            app:iconTint="@color/primary"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickPhoto"
                            style="@style/Hoe.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/verif_pick_photo"
                            app:icon="@drawable/ic_image"
                            app:iconTint="@color/primary"/>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendReport"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/verif_send_report"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Demandeur -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenAnalysis"
                style="@style/Hoe.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/verif_open_analysis"
                android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Hoe.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/verif_cancel"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
